%rec: definitions

var: DRAKE
set: ActorWithName('drake_gallows')

%rec: outcomes

if: IsActorDead(DRAKE)
do: AddChatter(DRAKE, 'No! No! No!')

if: IsActorAtNamedLocation(DRAKE, 'street_to_north_west')
do: AddChatter(DRAKE, 'I\'m out of here!')
do: ActorTransition(DRAKE)
do: RunScriptOnMap('zone_commerce', 'drakes_escape')

%rec: cancel

if: true
do: AddChatter(DRAKE, 'HUH?')

%rec: frames

if: true
do: SetGoalMoveToNamedLocation(DRAKE, 'hospital_backdoor')

if: IsActorAtNamedLocation(DRAKE, 'hospital_backdoor')
do: SetGoalMoveToNamedLocation(DRAKE, 'street_to_north_west', true)
