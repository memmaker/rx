%rec: definitions

var: DRAKE
set: ActorWithName('drake_gallows')

%rec: outcomes

if: IsActorDead(DRAKE)
do: AddChatter(DRAKE, 'No! No! No!')

if: IsActorAtNamedLocation(DRAKE, 'drakes_place')
do: AddChatter(DRAKE, 'Give me some of the good stuff!')

%rec: cancel

if: true
do: AddChatter(DRAKE, 'HUH?')

%rec: frames

if: true
do: SetGoalMoveToNamedLocation(DRAKE, 'drakes_place')
