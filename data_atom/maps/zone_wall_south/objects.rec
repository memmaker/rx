Category: StateChanger
Description: a switch
#
state_0_label: Airlock sealed
state_0_change: SetFlag('interior_airlock_closed') && SetFlag('exterior_airlock_closed')
state_0_rune: S
#
state_1_label: Airlock open (*DANGER*)
state_1_change: ClearFlag('interior_airlock_closed') && ClearFlag('exterior_airlock_closed')
state_1_rune: X
#
state_2_label: Airlock Interior Door Open
state_2_change: ClearFlag('interior_airlock_closed') && SetFlag('exterior_airlock_closed')
state_2_rune: I
#
state_3_label: Airlock Exterior Door Open
state_3_change: ClearFlag('exterior_airlock_closed') && SetFlag('interior_airlock_closed')
state_3_rune: E
Position: (42,14)

