%rec: Global

SkillCap: 200
#
SuccessChanceCap: 95
ChanceForCriticalFailure: 5
#
MaxArmorDR: 25
MaxArmorDT: 30
#
AblationWithoutPenetration: 1
AblationWithPenetration: 2
#
LockStrengthReductionPerSkill: 0.375

%rec: SkillDifficulty

#Trivial: skill + 90
#VeryEasy: skill + 60
#Easy: skill + 30
#Medium: skill
#Hard: skill - 30
#VeryHard: skill - 60
#SuperHuman: skill - 90

Trivial: 100
VeryEasy: skill + 60
Easy: skill + 30
Medium: skill
Hard: skill / 2
VeryHard: skill / 5
SuperHuman: 1

%rec: Skills

Name: Melee Combat
Short: Mle
Combat: Melee
BaseValue: (str + end) * 2

Name: Ranged Combat
Short: Rng
Combat: Ranged
BaseValue: (per + 5) * 2 * if(per > 3, 1, 0)

Name: Social
Short: Soc
BaseValue: (coo + 5) * 2 * if(coo > 3, 1, 0)

Name: Intimidate
Short: Int
BaseValue: (coo + str) * 2 * if(str > 3, 1, 0)

Name: Stealth
Short: Ste
BaseValue: (agi + 5) * 2 * if(agi > 3, 1, 0)

Name: Mechanics
Short: Mec
BaseValue: (agi + end) * 2 * if(agi > 3, 1, 0) * if(end > 3, 1, 0)

Name: BioChemistry
Short: Bio
BaseValue: (int + per) * 2 * if(int > 3, 1, 0)

Name: Technology
Short: Tec
BaseValue: (int + 5) * 2 * if(int > 3, 1, 0)

%rec: SkillMap

unarmed: Melee Combat
repairs: Mechanics
picklocks: Mechanics
pickpockets: Stealth
sneak: Stealth
hacking: Technology
backstabbing: Melee Combat
throwing: Ranged Combat
traps: Mechanics
intimidation: Intimidate
rangedattacks: Ranged Combat
smoothtalking: Social

%rec: DerivedStats

ActionPoints: 5 + (agi + (end / 2))
Dodge: agi
CarryWeight: 20 + (15 * str)
CriticalChance: 5
CriticalImpactModifier: 0
DamageResistance: 0
HealingRate: max(1, end / 3)
HitPoints: 15 + (2 * end) + str
MeleeDamageBonus: max(1, str - 5)
PartyLimit: floor(coo / 2.0)
PerkRate: 3
PoisonResistance: end * 5
Speed: 2 * agi
SkillRate: 3 + (int * 2)

%rec: LevelTable

xp: 0
xp: 1000
xp: 3000
xp: 6000
xp: 10000
xp: 15000
xp: 21000
xp: 28000
xp: 36000
xp: 45000
xp: 55000
xp: 66000
xp: 78000
xp: 91000
xp: 105000
xp: 120000
xp: 136000
xp: 153000
xp: 171000
xp: 190000
xp: 210000

%rec: AfterTable

xp: (currentLevel * (currentLevel - 1) / 2) * 1000

%rec: PerkRequirements

Perk: pickpocket
RequireSkill: Stealth(50)

Perk: quickdraw
RequireSkill: RangedCombat(30)
RequireStat: Agility(6)

Perk: one-liners
RequireSkill: Intimidate(30)
RequireStat: Cool(6)

Perk: charge
RequireSkill: MeleeCombat(30)
RequireStat: Agility(6)

Perk: disarm
RequireSkill: MeleeCombat(50)
RequireStat: Agility(6)

Perk: takedown
RequireSkill: MeleeCombat(30)

Perk: backstab
RequireSkill: MeleeCombat(50)
