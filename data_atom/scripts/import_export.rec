%rec: definitions

var: IMPORT_CONTAINER_FOOD
set: ContainerWithName('import_container_food')

var: IMPORT_CONTAINER_PARTS
set: ContainerWithName('import_container_parts')

var: IMPORT_CONTAINER_MILITARY
set: ContainerWithName('import_container_military')

var: IMPORT_CONTAINER_MEDICAL
set: ContainerWithName('import_container_medical')

%rec: outcomes

%rec: cancel

%rec: frames

if: true
do: SaveTimeNow('cargo_imported')
do: ContainerEnsure(IMPORT_CONTAINER_FOOD, 'binge', 10)
do: ContainerEnsure(IMPORT_CONTAINER_FOOD, 'water_ration', 10)
do: ContainerEnsure(IMPORT_CONTAINER_PARTS, 'robot_repair_parts', 10)
do: ContainerEnsure(IMPORT_CONTAINER_MILITARY, '12_ga_shotgun_shells', 10)
do: ContainerEnsure(IMPORT_CONTAINER_MILITARY, '9mm', 10)
do: ContainerEnsure(IMPORT_CONTAINER_MILITARY, 'micro_fusion_cell', 10)
do: ContainerEnsure(IMPORT_CONTAINER_MEDICAL, 'liquid_methane', 10)
do: ContainerEnsure(IMPORT_CONTAINER_MEDICAL, 'lidocaine', 10)
do: ContainerEnsure(IMPORT_CONTAINER_MEDICAL, 'butch', 10)
do: ContainerEnsure(IMPORT_CONTAINER_MEDICAL, 'brainz', 10)

if: IsHoursAfter('cargo_imported', 36)
do: RestartScript('import_export')