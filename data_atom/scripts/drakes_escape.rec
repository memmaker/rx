%rec: definitions

var: DRAKE
set: ActorWithName('drake_gallows')

%rec: outcomes

if: IsActorAtNamedLocation(DRAKE, 'zone_commerce', 'drakes_place')
do: AddChatter(DRAKE, 'Give me some of the good stuff!')

if: IsActorDead(DRAKE)
do: AddChatter(DRAKE, 'No! No! No!')

%rec: cancel

do: AddChatter(DRAKE, 'HUH?')

%rec: frames

if: IsActorAbleToReach(DRAKE, 'secret_ladder')
do: AddChatter(DRAKE, 'About time!')
do: SetFlag('drake_freed')
do: MoveTo(DRAKE, 'zone_commerce', 'drakes_place')

